#!/bin/bash
# Keep network shares mounted and in Finder's sidebar. Each run:
#  1. adds SMB/AFP shares you mounted yourself to the config,
#  2. unmounts each configured share whose server has gone away,
#  3. remounts each configured share whose server is reachable,
#  4. adds each mounted share to the sidebar Favorites if it's missing.
set -u

if [ "${1:-}" = -h ] || [ "${1:-}" = --help ]; then
  cat <<'EOF'
usage: smb-autoreconnect

Remounts the shares listed in ~/.config/smb-autoreconnect/shares (one URL per
line, e.g. smb://user@host/share) when their server is reachable, and keeps them
in Finder's sidebar. Shares you mount yourself are added to the list.
Prefix a line with ! to ignore that share. Run it with:
  brew services start smb-autoreconnect
EOF
  exit 0
fi

CONFIG="${SMB_AUTORECONNECT_CONFIG:-$HOME/.config/smb-autoreconnect/shares}"
MOUNT_TIMEOUT="${SMB_AUTORECONNECT_MOUNT_TIMEOUT:-30}"
SIDEBAR="$(dirname "$(realpath "$0")")/../libexec/smb-autoreconnect-sidebar"
log() { printf '%s %s\n' "$(date '+%F %T')" "$*"; }

# smb://user@host:445/share or //user@host/share -> host/share, lowercased
key() {
  local r=${1#*//} h
  r=${r#*@}; h=${r%%/*}; h=${h%:*}
  printf '%s/%s\n' "$h" "${r#*/}" | tr '[:upper:]' '[:lower:]'
}

# scheme://user@host:port/share -> "host port" (default port per scheme)
endpoint() {
  local scheme=${1%%://*} hp=${1#*://}
  hp=${hp%%/*}; hp=${hp#*@}
  case $hp in
    *:*) printf '%s %s\n' "${hp%:*}" "${hp##*:}" ;;
    *)   case $scheme in afp) printf '%s 548\n' "$hp" ;; *) printf '%s 445\n' "$hp" ;; esac ;;
  esac
}

# The server accepts a TCP connection. Retried once so a blip doesn't count.
reachable() {
  nc -z -G 2 "$1" "$2" >/dev/null 2>&1 && return 0
  sleep 1
  nc -z -G 2 "$1" "$2" >/dev/null 2>&1
}

# Config lines without comments or blanks.
entries() { sed -E 's/#.*//; s/^[[:space:]]+//; s/[[:space:]]+$//; /^$/d' "$CONFIG"; }

# Your SMB/AFP mounts as "smb<TAB>user@host/share<TAB>/Volumes/share".
mounted_shares() {
  mount | grep "mounted by $(id -un))" | grep -v nobrowse |
    sed -nE $'s#^//([^ ]+) on (/.*) \\((smb|afp)fs,.*#\\3\t\\1\t\\2#p'
}

# Only run when fully awake. During a DarkWake (Power Nap / maintenance wake
# while asleep) the system drops Graphics and soon sleeps again, which freezes
# a half-done "mount volume" for good; launchd then never starts another run.
caps=$(pmset -g systemstate 2>/dev/null | sed -n 's/.*Capabilities are://p')
[ -n "$caps" ] && [[ $caps != *Graphics* ]] && exit 0

mkdir -p "$(dirname "$CONFIG")"
touch "$CONFIG"

# 1. Add shares mounted by hand to the config.
known=$(entries | sed 's/^!//' | while IFS= read -r u; do key "$u"; done)
while IFS=$'\t' read -r scheme spec _; do
  [ -n "$scheme" ] || continue
  k=$(key "//$spec")
  grep -qxF "$k" <<<"$known" && continue
  [ -n "$(tail -c1 "$CONFIG")" ] && echo >>"$CONFIG"
  echo "$scheme://$spec" >>"$CONFIG"
  known+=$'\n'"$k"
  log "added $scheme://$spec to $CONFIG"
done <<<"$(mounted_shares)"

wanted=$(entries | grep -v '^!' | while IFS= read -r u; do key "$u"; done)

# 2. Unmount wanted shares whose server is unreachable (sleep, leaving the
# network, Tailscale down). Left mounted, the share stops responding and macOS
# pops up "Server connections interrupted"; step 3 remounts it once the server
# is back.
while IFS=$'\t' read -r scheme spec mp; do
  [ -n "$spec" ] || continue
  grep -qxF "$(key "//$spec")" <<<"$wanted" || continue
  read -r host port <<<"$(endpoint "$scheme://$spec")"
  reachable "$host" "$port" && continue
  log "unmounting $mp: $host:$port unreachable"
  # Through Disk Arbitration: umount(8) needs root even for your own mounts.
  if ! out=$(timeout -k 5 20 diskutil unmount force "$mp" 2>&1); then
    log "failed to unmount $mp: ${out:-timed out}"
  fi
done <<<"$(mounted_shares)"

# 3. Remount configured shares whose server answers.
mounted_keys=$(mounted_shares | cut -f2 | while IFS= read -r s; do [ -n "$s" ] && key "//$s"; done)
while IFS= read -r url; do
  [ -n "$url" ] || continue
  case $url in '!'*) continue ;; esac
  grep -qxF "$(key "$url")" <<<"$mounted_keys" && continue

  read -r host port <<<"$(endpoint "$url")"
  nc -z -G 2 "$host" "$port" >/dev/null 2>&1 || continue

  # Bound the mount so a hang (sleep mid-mount, server stalls) can't block
  # every later run.
  log "mounting $url"
  if out=$(timeout -k 5 "$MOUNT_TIMEOUT" osascript -e "mount volume \"$url\"" 2>&1); then
    log "mounted $url -> $out"
  else
    rc=$?
    [ "$rc" -ge 124 ] && out="timed out after ${MOUNT_TIMEOUT}s"
    log "failed $url: $out"
  fi
done <<<"$(entries)"

# 4. Put each wanted, mounted share in the sidebar if it isn't there.
[ -x "$SIDEBAR" ] || exit 0
paths=()
while IFS=$'\t' read -r _ spec mp; do
  [ -n "$spec" ] && grep -qxF "$(key "//$spec")" <<<"$wanted" && paths+=("$mp")
done <<<"$(mounted_shares)"
[ ${#paths[@]} -gt 0 ] || exit 0
"$SIDEBAR" "${paths[@]}" | while IFS= read -r p; do log "added $p to the sidebar"; done
